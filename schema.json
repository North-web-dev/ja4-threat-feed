{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ja4-threat-feed",
  "type": "object",
  "required": ["metadata", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "metadata": {
      "type": "object",
      "required": ["description", "updated"],
      "properties": {
        "description": {"type": "string"},
        "reflector": {"type": "string"},
        "updated": {"type": "string", "format": "date"},
        "measured_count": {"type": "integer"},
        "cited_count": {"type": "integer"},
        "cadence": {"type": "string"},
        "license": {"type": "string"},
        "pairs_with": {"type": "array", "items": {"type": "string"}}
      }
    },
    "references": {"type": "object"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ja4", "category", "label", "verdict", "source", "provenance"],
        "additionalProperties": false,
        "properties": {
          "ja4": {"type": "string", "pattern": "^[tq]\\d{2}[di]\\d{2}\\d{2}[a-z0-9]{2}_[0-9a-f]{12}_[0-9a-f]{12}$"},
          "ja4h": {"type": "string"},
          "akamai_h2": {"type": "string"},
          "category": {"type": "string", "enum": ["browser", "library", "tool", "scanner", "unknown"]},
          "label": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["allow", "non-browser", "suspicious"]},
          "source": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "required": ["method", "date"],
            "properties": {
              "method": {"type": "string", "enum": ["measured", "cited"]},
              "date": {"type": "string", "format": "date"},
              "tool": {"type": "string"},
              "version": {"type": "string"},
              "ref": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
